flowchart TB
  %% vidLM AI - System Design

  User[User]

  subgraph FE[Frontend - React + TypeScript + Vite]
    AppUI[App.tsx UI]
    Poller[Health + Jobs Polling]
    QueueView[Queue + Progress UI]
  end

  subgraph API[Backend - FastAPI]
    Main[main.py]
    H1[GET /health]
    H2[POST /jobs/transcribe]
    H3[POST /jobs/transcribe-collection]
    H4[GET /jobs]
    H5[GET /jobs/{job_id}]
    H6[DELETE /jobs/{job_id}]
  end

  subgraph CORE[Service Layer - TranscriptionService]
    Discover[discover_videos]
    Enqueue[enqueue_collection_jobs]
    WorkerQ[(In-memory Queue)]
    Worker[Background Worker Thread]
    RunJob[_run_job]
    Audio[ffmpeg audio extraction]
    ProviderChain[Provider chain resolver\nlocal | openai | auto]
    Preflight[Provider preflight\n(binary/model/key checks)]
    Meta[(metadata.json per job)]
  end

  subgraph Providers[Transcription Providers]
    Local[LocalWhisperCppProvider\nwhisper-cli + ggml model]
    OpenAI[OpenAIWhisperProvider\nOpenAI API]
  end

  subgraph Storage[Runtime Data Root (outside repo)]
    JobsDir[jobs/<job_id>/]
    MetaFile[metadata.json]
    AudioWav[audio.wav]
    Transcript[transcript.txt]
  end

  subgraph Config[Configuration]
    Settings[config/settings.toml]
    Secrets[config/secrets.env]
  end

  User --> AppUI
  AppUI --> Poller
  AppUI --> QueueView

  Poller --> H1
  QueueView --> H3
  QueueView --> H4
  QueueView --> H5
  QueueView --> H6

  H1 --> Main
  H2 --> Main
  H3 --> Main
  H4 --> Main
  H5 --> Main
  H6 --> Main

  Main --> Preflight
  Main --> Discover
  Main --> Enqueue
  Main --> RunJob

  Discover --> Enqueue
  Enqueue --> WorkerQ
  WorkerQ --> Worker
  Worker --> RunJob

  RunJob --> Audio
  RunJob --> ProviderChain
  ProviderChain --> Local
  ProviderChain --> OpenAI

  RunJob --> Meta
  Meta --> MetaFile
  RunJob --> AudioWav
  RunJob --> Transcript

  JobsDir --> MetaFile
  JobsDir --> AudioWav
  JobsDir --> Transcript

  Settings --> Main
  Secrets --> Main

  Main --> H1
  Main --> H2
  Main --> H3
  Main --> H4
  Main --> H5
  Main --> H6

  %% Job lifecycle states
  subgraph Lifecycle[Job Lifecycle]
    Q[queued\n0%]
    P[processing\n10% -> 40% -> 100%]
    C[completed]
    F[failed]
    X[canceled]
  end

  Enqueue --> Q
  Worker --> P
  P --> C
  P --> F
  H6 --> X

  classDef api fill:#e0f2fe,stroke:#0369a1,color:#0c4a6e;
  classDef svc fill:#ecfeff,stroke:#0f766e,color:#134e4a;
  classDef data fill:#f8fafc,stroke:#64748b,color:#334155;
  classDef warn fill:#fff7ed,stroke:#c2410c,color:#9a3412;

  class Main,H1,H2,H3,H4,H5,H6 api;
  class Discover,Enqueue,WorkerQ,Worker,RunJob,Preflight,ProviderChain svc;
  class JobsDir,MetaFile,AudioWav,Transcript,Meta data;
  class Local,OpenAI warn;
